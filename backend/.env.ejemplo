# Copia este archivo como .env (no se sube al repositorio) y completa tus datos.
# En AWS estas mismas variables se cargan en la configuración de cada Lambda.

BD_SERVIDOR=localhost
BD_PUERTO=1433
BD_NOMBRE=malvitec
# Déjalos vacíos para entrar con tu cuenta de Windows (solo en local).
BD_USUARIO=
BD_CONTRASENA=

# Clave para firmar el token. Todas las Lambdas deben tener la misma.
JWT_SECRETO=cambia-esta-clave-solo-para-local

CORS_ORIGEN=*
